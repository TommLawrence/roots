# ---- Longview configuration (copy to .env) ----

# Open-weights model served locally by Ollama.
# On an 8GB laptop use the 3B Q4 quant (~2GB RAM). Emergency fallback: qwen2.5:1.5b-instruct-q4_K_M
LONGVIEW_MODEL=qwen2.5:3b-instruct-q4_K_M
LONGVIEW_LLM_BASE_URL=http://localhost:11434/v1

# "ollama" (default, local open-weights) or "openai-compatible" (frontier model side-by-side demo)
LONGVIEW_LLM_PROVIDER=ollama

# Frontend-model comparison (optional, only for the side-by-side demo in the video)
# LONGVIEW_FRONTIER_BASE_URL=
# LONGVIEW_FRONTIER_API_KEY=
# LONGVIEW_FRONTIER_MODEL=

# Paths
LONGVIEW_DB=data/longview.db

# Audit: every tool call is logged with actor, args, result, timestamp
LONGVIEW_ACTOR=agent
